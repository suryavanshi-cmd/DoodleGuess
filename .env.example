# Supabase project (Project Settings -> API)
# Safe to expose: used by the browser for Realtime only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only. Bypasses RLS, so it must never be prefixed NEXT_PUBLIC_
# and must never be committed. Set it in Vercel as an encrypted env var.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Optional: point the browser at the Supabase Edge Function backend instead of
# this app's own /api routes. With this set, no secret is needed here at all.
# NEXT_PUBLIC_GAME_API=https://your-project.supabase.co/functions/v1/game
